# Used by docker-compose.yml for local/self-hosted deployment.
# Copy to .env and fill in real values before running `docker compose up`.

DB_DATABASE=aten
DB_USERNAME=aten
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# The public URL the browser will use to reach the API (through the nginx
# service, published on host port 8080 by default).
NEXT_PUBLIC_API_URL=http://localhost:8080
